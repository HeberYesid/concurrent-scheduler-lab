<?xml version="1.0" encoding="UTF-8"?>
<ruleset
        name="Scheduler PMD Rules"
        xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.github.io/schema/ruleset_2_0_0.xsd">
    <description>
        Reglas mínimas del curso para Java: complejidad ciclomática por método menor o igual a 10.
    </description>

    <rule ref="category/java/design.xml/CyclomaticComplexity">
        <properties>
            <property name="methodReportLevel" value="10"/>
            <property name="classReportLevel" value="200"/>
        </properties>
    </rule>
</ruleset>
